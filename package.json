{
  "name": "reachinbox-email-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Email Scheduling Platform with BullMQ, Redis, MySQL, Next.js, and Ethereal Email",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspaces --if-present",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "verify:restart-safety": "ts-node scripts/verify-restart-safety.ts",
    "verify:1000-load": "ts-node scripts/verify-1000-load.ts"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
